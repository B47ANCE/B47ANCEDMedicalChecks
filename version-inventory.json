{
  "schema": 1,
  "canonical": "VERSION",
  "mirrors": [
    {
      "path": "README.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "src/B47ANCEDMedicalChecks/42/mod.info",
      "pattern": "^modversion=(?P<version>\\S+)$"
    },
    {
      "path": "src/B47ANCEDMedicalChecks/42/media/lua/shared/B47ANCEDMedicalChecks/Config.lua",
      "pattern": "version\\s*=\\s*\"(?P<version>[^\"]+)\""
    },
    {
      "path": "WORKSHOP_CHANGE_NOTE.txt",
      "pattern": "^\\[b\\]Version (?P<version>[^\\[]+)\\[/b\\]$"
    },
    {
      "path": "docs/ARCHITECTURE.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/ROADMAP.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/INSTALLATION.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/VERSIONING.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/TESTING.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/IMPLEMENTATION_REPORT.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/VALIDATION.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/BRANDING.md",
      "pattern": "^Current authoring version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/COMPATIBILITY.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    }
  ],
  "changelog": {
    "path": "CHANGELOG.md",
    "pattern": "^## \\[(?P<version>[^\\]]+)\\]$"
  },
  "packaging": {
    "artifacts": [
      {
        "glob": "dist/*-current/*.zip",
        "pattern": "B47ANCEDMedicalChecks-development-(?P<version>.+)\\.zip",
        "zip_members": [
          {
            "member": "B47ANCEDMedicalChecks/VERSION",
            "pattern": "^(?P<version>\\S+)$"
          },
          {
            "member": "B47ANCEDMedicalChecks/Contents/mods/B47ANCEDMedicalChecks/42/mod.info",
            "pattern": "^modversion=(?P<version>\\S+)$"
          }
        ]
      }
    ]
  },
  "other_versions": [
    {
      "category": "pz",
      "reference": "mod.info versionMin/versionMax and SOURCE_AUDIT",
      "reason": "Supported upstream build, independent of project SemVer"
    },
    {
      "category": "framework",
      "reference": "docs/VERSION_POLICY.md and scripts/check_versions.py",
      "reason": "Framework provenance, not a mod dependency"
    },
    {
      "category": "inventory-schema",
      "reference": "version-inventory.json schema",
      "reason": "Version-check inventory format"
    },
    {
      "category": "compatibility",
      "reference": "Config.lua protocol and schema",
      "reason": "Lua-only metadata schema/protocol, independent of project version"
    }
  ],
  "historical": [
    {
      "reference": "handoff/",
      "reason": "Immutable extracted user design specification"
    },
    {
      "reference": "research/",
      "reason": "Dated source evidence; not current project metadata"
    },
    {
      "reference": "history/, native/, research/, dist/current/",
      "reason": "Immutable/local Java-era evidence and artifacts; not active dependencies or current version mirrors"
    },
    {
      "reference": "docs/BRANDING.md historical fallback provenance",
      "reason": "Prior authoring version, original fallback hashes and source provenance remain historical"
    },
    {
      "reference": "docs/PUBLICATION-0.3.0-dev.5.json",
      "reason": "Immutable actual Workshop distribution receipt pinned to source b799134, version 0.3.0-dev.5 and its package hashes; not current runtime evidence or a future version mirror"
    },
    {
      "reference": "docs/WORKSHOP_DESCRIPTION.md",
      "reason": "Retired Markdown draft; owner-edited live BBCode was adopted as canonical WORKSHOP_DESCRIPTION.txt for the .6 publication without discarding the earlier source"
    },
    {
      "reference": "docs/PUBLICATION-0.3.0-dev.6.json",
      "reason": "Immutable actual .6 Workshop distribution receipt, pinned to merged source 10702b7 and recorded hashes; not a future current-version mirror or runtime validation"
    }
  ]
}
